FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /build
COPY src/main/java/game/model ./core/game/model/
COPY web/src ./web/
RUN mkdir -p classes && find core web -name '*.java' -print > sources.txt && javac --release 21 --add-modules jdk.httpserver -encoding UTF-8 -d classes @sources.txt
COPY web/public ./classes/public
RUN jar --create --file game.jar --main-class game.web.GameServer -C classes .

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /build/game.jar ./game.jar
ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000
USER 10001
CMD ["java", "--add-modules", "jdk.httpserver", "-XX:MaxRAMPercentage=70", "-jar", "game.jar"]
