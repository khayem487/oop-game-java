<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fr.khayem</groupId>
  <artifactId>oop-game</artifactId>
  <version>2.0.0</version>
  <name>OOP Game - Les jardins oublies</name>
  <description>Java OOP coursework game with a shared model, console, JavaFX and browser editions.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <junit.version>5.14.4</junit.version>
    <javafx.version>21.0.13</javafx.version>
    <game.build.directory>target</game.build.directory>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${game.build.directory}</directory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>web/public</directory><targetPath>public</targetPath></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions>
          <execution><id>web-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>web/src</source></sources></configuration></execution>
          <execution><id>web-tests</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>web/tests</source></sources></configuration></execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version><configuration><useModulePath>false</useModulePath></configuration></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>game.cli.Main</mainClass></manifest></archive></configuration>
        <executions><execution><id>web-jar</id><goals><goal>jar</goal></goals><configuration><classifier>web</classifier><archive><manifest><mainClass>game.web.GameServer</mainClass></manifest></archive></configuration></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.11.2</version><configuration><doclint>all,-missing</doclint></configuration></plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>desktop</id>
      <dependencies><dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency></dependencies>
      <build>
        <resources><resource><directory>desktop/src/main/resources</directory></resource></resources>
        <plugins>
          <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution><id>desktop-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>desktop/src/main/java</source></sources></configuration></execution>
              <execution><id>desktop-tests</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>desktop/src/test/java</source></sources></configuration></execution>
            </executions>
          </plugin>
          <plugin><groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version><configuration><mainClass>game.desktop.DesktopLauncher</mainClass></configuration></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
            <executions><execution><id>desktop-libraries</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals><configuration><includeScope>runtime</includeScope><includeGroupIds>org.openjfx</includeGroupIds><outputDirectory>${project.build.directory}/desktop-dependencies</outputDirectory></configuration></execution></executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
